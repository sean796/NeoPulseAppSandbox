{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["publishDates", "publishTime"],
  "properties": {
    "publishDates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "minItems": 1
    },
    "publishTime": {
      "type": "string",
      "pattern": "^\\d{2}:\\d{2}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fact-checker-page-claims",
  "title": "FactCheckerPageClaims",
  "type": "object",
  "additionalProperties": false,
  "required": ["pageId", "claims"],
  "properties": {
    "pageId": {
      "type": "integer",
      "minimum": 1
    },
    "aiseo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score"],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quote", "category", "verdict"],
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "product_spec",
              "operating_system",
              "materials",
              "energy",
              "safety",
              "warranty",
              "pricing",
              "compatibility",
              "durability",
              "installation",
              "lifespan",
              "cleaning_maintenance",
              "climate",
              "business_services",
              "none"
            ]
          },
          "verdict": {
            "type": "string",
            "enum": [
              "supported",
              "partially_supported",
              "unsupported",
              "contradicted",
              "business_confirmation_required",
              "no_product_claim"
            ]
          },
          "sourceTitle": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string"
          },
          "sourceType": {
            "type": "string",
            "enum": ["manufacturer", "manual", "government", "independent", "industry", ""]
          },
          "qualification": {
            "type": "string"
          },
          "product": {
            "type": "string"
          },
          "suggestedWording": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "major", "moderate", "minor", ""]
          }
        }
      }
    }
  }
}
